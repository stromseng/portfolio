---
// Day/night switch, shown as a bare sun or moon icon in the header. The
// initial theme is set by the inline script in the page <head> (stored choice,
// else the system setting); this button flips it and remembers the choice in
// localStorage under "theme".
---

<button type="button" class="toggle" data-theme-toggle>
  <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <g class="toggle-sun">
      <path
        d="M20 12c4.6-.2 8 3.4 8 8 0 4.4-3.5 8-8.1 7.9C15.6 27.8 12 24.3 12 20c0-4.5 3.5-8 8.3-7.8"
      ></path>
      <path
        d="M20 3v4M20 33v4M3 20h4M33 20h4M8 8l3 3M29 29l3 3M8 32l3-3M29 11l3-3"
      ></path>
    </g>
    <path
      class="toggle-moon"
      d="M26 7c-7.5-1.8-15 3.3-15.6 11.4C9.8 26.6 16.7 33.5 25 32.7c3.2-.3 5.6-1.6 7.6-3.7-7.3.7-13-5.2-12.4-12.5.3-4.3 2.4-7.5 5.8-9.5Z"
    ></path>
  </svg>
</button>

<script>
  const KEY = "theme";
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]",
  );
  const systemDark = window.matchMedia("(prefers-color-scheme: dark)");

  type Theme = "day" | "night";

  const current = (): Theme =>
    root.dataset.theme === "night" ? "night" : "day";

  function render() {
    const next = current() === "night" ? "day" : "night";
    button?.setAttribute("aria-label", `Switch to ${next} mode`);
  }

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  // Swaps the theme in one step, cross-fading the whole page where the
  // browser supports view transitions. Never runs on load.
  function apply(theme: Theme) {
    const swap = () => {
      root.dataset.theme = theme;
      render();
    };
    if (!("startViewTransition" in document) || reducedMotion.matches) {
      swap();
      return;
    }
    document.startViewTransition(swap);
  }

  button?.addEventListener("click", () => {
    const theme = current() === "night" ? "day" : "night";
    try {
      localStorage.setItem(KEY, theme);
    } catch {
      // Private mode: the switch still works for this visit.
    }
    apply(theme);
  });

  systemDark.addEventListener("change", (event) => {
    let stored: string | null = null;
    try {
      stored = localStorage.getItem(KEY);
    } catch {}
    if (!stored) apply(event.matches ? "night" : "day");
  });

  render();
</script>

<style>
  /* Sized like the GitHub and LinkedIn icons next to it, and fixed to the
     header's top-right corner so it stays in view while scrolling. */
  .toggle {
    position: fixed;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 20;
    display: block;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }
  /* A soft, borderless blur behind the icon, so it stays readable over the
     scenes while scrolling. The mask feathers its edge into the page. */
  .toggle::before {
    content: "";
    position: absolute;
    inset: -0.5rem;
    z-index: -1;
    border-radius: 50%;
    background: color-mix(in srgb, var(--sky) 55%, transparent);
    backdrop-filter: blur(6px);
    mask-image: radial-gradient(closest-side, #000 55%, transparent);
  }
  .toggle:hover {
    rotate: -2deg;
  }
  svg {
    display: block;
    width: 3rem;
    height: 3rem;
    fill: none;
    stroke: var(--line);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Shows the current theme: a sun by day, a moon at night. */
  .toggle-moon {
    fill: var(--star);
    opacity: var(--is-night);
  }
  .toggle-sun {
    opacity: calc(1 - var(--is-night));
  }
  .toggle-sun path:first-child {
    fill: var(--sun);
  }
  @media (prefers-reduced-motion: no-preference) {
    .toggle {
      transition: rotate 0.2s;
    }
  }
</style>
