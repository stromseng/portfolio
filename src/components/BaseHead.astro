---
// The <head> tags every page shares, including the day/night bootstrap. Pages
// add their own through the slot: the blog (components/blog/BlogLayout.astro)
// and the project pages (MetaLayout) add the ClientRouter.
import ThemeScript from "@/components/ThemeScript.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Magnus Alexander Strømseng, a developer at Bekk in Oslo. Projects, work and education.",
} = Astro.props;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="color-scheme" content="light dark" />
<ThemeScript />
<slot />
