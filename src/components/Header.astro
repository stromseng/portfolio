---
// The site header: Home/Blog centred, GitHub and LinkedIn on the right. Pages
// can add controls after the socials through the slot (the homepage's theme
// toggle). Icons draw in `--color-line`, which follows the text colour except
// on the homepage at night. It resets the homepage's body font variation, so
// it looks the same on every page.
import github from "@images/github.svg?raw";
import linkedin from "@images/linkedin.svg?raw";
import { themeSvg } from "@/lib/scene/themeSvg";
import { cn } from "@/lib/utils";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const { pathname } = Astro.url;

const links = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
];
const socials = [
  { href: "https://github.com/stromseng", label: "GitHub", icon: github },
  {
    href: "https://www.linkedin.com/in/stromseng/",
    label: "LinkedIn",
    icon: linkedin,
  },
];
---

<header
  class={cn(
    "flex w-full items-center justify-evenly gap-4 p-2 [font-variation-settings:normal] md:justify-between md:gap-0",
    className,
  )}
>
  <div class="hidden flex-1 md:block"></div>
  <nav
    aria-label="Main"
    class="flex flex-1 items-center justify-evenly gap-4 text-2xl font-semibold md:justify-center"
  >
    {
      links.map(({ href, label }) => (
        <a
          href={href}
          class="hover:underline aria-[current=page]:underline"
          aria-current={pathname === href ? "page" : undefined}
        >
          {label}
        </a>
      ))
    }
  </nav>
  {
    /* Extra controls (the homepage's fixed theme toggle) sit at the right
      edge, so the socials pack against them instead of spreading out. */
  }
  <div
    class={cn(
      "flex flex-1 items-center gap-4 md:justify-end",
      Astro.slots.has("default") ? "justify-end" : "justify-evenly",
    )}
  >
    {
      socials.map(({ href, label, icon }) => (
        <a class="w-12" href={href} aria-label={label}>
          <Fragment
            set:html={themeSvg(icon, {
              id: `${label}-head`,
              className: "w-full",
            })}
          />
        </a>
      ))
    }
    <slot />
  </div>
</header>
