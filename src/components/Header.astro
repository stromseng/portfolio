---
import GithubLogo from "@images/github.svg";
import LinkedInLogo from "@images/linkedin.svg";
import { cn } from "@/lib/utils";

const pathname = Astro.url.pathname;
const isHome = pathname === "/";
const isBlog = pathname === "/blog";
const linkClass = (isActive: boolean) =>
  cn(
    "decoration-black hover:underline hover:decoration-black hover:duration-500",
    { underline: isActive },
  );
---

<header
  class="flex w-full items-center justify-evenly gap-4 p-2 md:justify-between md:gap-0"
>
  <div class="hidden md:block md:flex-1"></div>
  <!-- Centered Links -->
  <div
    class={`ShantellSans flex flex-1 items-center justify-evenly gap-4 text-2xl font-semibold md:flex-1 md:justify-center`}
  >
    <a href="/" class={linkClass(isHome)}>Home</a>
    <a href="/blog" class={linkClass(isBlog)}>Blog</a>
  </div>
  <!-- Socials -->
  <div
    class="flex flex-1 items-center justify-evenly gap-4 md:flex-1 md:justify-end"
  >
    <a href="https://github.com/stromseng"
      ><img src={GithubLogo.src} alt="Github Logo" class="size-12" /></a
    >
    <a href="https://www.linkedin.com/in/stromseng/"
      ><img src={LinkedInLogo.src} alt="LinkedIn Logo" class="size-12" /></a
    >
  </div>
</header>
