---
// The site header: Home/Blog centred, GitHub, LinkedIn and the theme toggle on
// the right. Icons draw in `--color-line`, which follows the text colour except
// at night. It resets the illustrated pages' body font variation (scenes.css),
// so it looks the same on every page.
import github from "@images/github.svg?raw";
import linkedin from "@images/linkedin.svg?raw";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { themeSvg } from "@/lib/scene/themeSvg";

const { pathname } = Astro.url;

const links = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
];
const socials = [
  { href: "https://github.com/stromseng", label: "GitHub", icon: github },
  {
    href: "https://www.linkedin.com/in/stromseng/",
    label: "LinkedIn",
    icon: linkedin,
  },
];
---

<header
  class="flex w-full items-center justify-evenly gap-4 p-2 [font-variation-settings:normal] md:justify-between md:gap-0"
>
  <div class="hidden flex-1 md:block"></div>
  <nav
    aria-label="Main"
    class="flex flex-1 items-center justify-evenly gap-4 text-2xl font-semibold md:justify-center"
  >
    {
      links.map(({ href, label }) => (
        <a
          href={href}
          class="hover:underline aria-[current=page]:underline"
          aria-current={pathname === href ? "page" : undefined}
        >
          {label}
        </a>
      ))
    }
  </nav>
  <div class="flex flex-1 items-center justify-end gap-4">
    {
      socials.map(({ href, label, icon }) => (
        <a class="w-12" href={href} aria-label={label}>
          <Fragment
            set:html={themeSvg(icon, {
              id: `${label}-head`,
              className: "w-full",
            })}
          />
        </a>
      ))
    }
    {
      /* The toggle is fixed to the viewport's top-right corner, so it stays in
        view while scrolling. This box holds its place in the row. */
    }
    <span class="size-12"><ThemeToggle /></span>
  </div>
</header>
