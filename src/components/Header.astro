---
import GithubLogo from "@images/github.svg";
import LinkedInLogo from "@images/linkedin.svg";

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1); // remove the first "/"
---

<header class="flex grow justify-between p-2">
  <div class="grow basis-full"></div>
  <!-- Centered Links -->
  <div
    class={"ShantellSans flex grow basis-full items-center justify-center gap-4 space-x-4 text-2xl font-semibold"}
  >
    <a href="/" class={currentPath === "" ? "underline" : "" + "decoration-white hover:underline hover:decoration-black hover:duration-500"}>Home</a>
    <a
      href="/blog"
      class={currentPath === "blog" ? "underline" : "" + "decoration-white hover:underline hover:decoration-black hover:duration-500"}
      >Blog</a
    >
  </div>
  <!-- Socials -->
  <div class="flex grow basis-full items-center justify-end gap-4">
    <a href="https://github.com/stromseng"><img src={GithubLogo.src} alt="Github Logo" class="size-12"/></a>
    <a href="https://www.linkedin.com/in/stromseng/"><img src={LinkedInLogo.src} alt="LinkedIn Logo" class="size-12"/></a>
  </div>
</header>
