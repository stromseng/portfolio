---
import TimelineItem from "./TimelineItem.astro";
import type { TimelineItemProps } from "./TimelineItem.astro";

export interface TimelineColumnProps {
  title: string;
  items: TimelineItemProps[];
}

const { title, items } = Astro.props as TimelineColumnProps;
---
<div class="flex min-w-[260px] grow flex-col gap-6">
  <h2 class="text-4xl font-bold">{title}</h2>
  <div class="flex flex-col gap-6">
    {items.map((item) => (
      <TimelineItem {...item} key={`${item.period}-${item.title}`} />
    ))}
  </div>
</div>
