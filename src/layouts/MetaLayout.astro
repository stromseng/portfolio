---
// The project pages' shell. Like the homepage and the blog it follows the
// day/night theme (see ThemeScript.astro), but night only changes the colours:
// pages style themselves with `dark:` and pass their body colours in.
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
// Supports weights 300-800
import "@fontsource-variable/shantell-sans";
import "@/styles/globals.css";
import { ClientRouter } from "astro:transitions";
import BaseHead from "@/components/BaseHead.astro";

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const { title, description, bodyClass = "" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description}>
      <ClientRouter />
    </BaseHead>
  </head>
  <body class={bodyClass}>
    <slot />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
