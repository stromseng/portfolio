---
// One blog post under the rooftop band (components/blog/). The article sits
// straight on the page: paper by day, the homepage's night sky with cream
// text at night.
import { getCollection, render } from "astro:content";
import BackLink from "@/components/backlink.astro";
import BlogLayout from "@/components/blog/BlogLayout.astro";
import { formatDate, pill } from "@/components/blog/post";
import PillBadge from "@/components/PillBadge";
import { prose } from "@/components/prose";
import { TypographyH1 } from "@/components/ui/typography";

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BlogLayout
  title={`${post.data.title} • Magnus A. Strømseng`}
  description={post.data.description}
>
  <div class="pt-6">
    <BackLink href="/blog" />
  </div>
  <article
    class="mx-auto flex w-full max-w-6xl flex-col items-center gap-4 px-4 pb-16"
  >
    <TypographyH1 className="text-center font-bold">
      {post.data.title}
    </TypographyH1>
    <p
      class="max-w-2xl text-center text-lg leading-relaxed text-black/80 dark:text-ink-soft"
    >
      {post.data.description}
    </p>
    <PillBadge
      as="time"
      dateTime={post.data.pubDate.toISOString()}
      background={pill.date}
      className={pill.border}
    >
      {formatDate(post.data.pubDate)}
    </PillBadge>
    {
      post.data.tags?.length ? (
        <div class="flex flex-wrap justify-center gap-2">
          {post.data.tags.map((tag) => (
            <PillBadge
              background={pill.tag}
              className={`px-3 py-1 text-[11px] tracking-[0.35em] ${pill.border}`}
            >
              #{tag}
            </PillBadge>
          ))}
        </div>
      ) : null
    }
    <div class:list={["px-2", prose]}>
      <Content />
    </div>
  </article>
</BlogLayout>
