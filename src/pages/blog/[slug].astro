---
import HeaderFooter from "@/layouts/HeaderFooter.astro";
import MetaLayout from "@/layouts/MetaLayout.astro";
import { getCollection, render } from "astro:content";
import BackLink from "@/components/backlink.astro";
import { TypographyH1 } from "@/components/ui/typography";
import { Separator } from "@/components/ui/separator";
import PaperPanel from "@/components/PaperPanel.astro";
export const prerender = true;

// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}
// 2. For your template, you can get the entry directly from the prop
const { post } = Astro.props;
const { Content } = await render(post);
---

<MetaLayout title="Blog">
  <HeaderFooter>
    <!-- <Separator /> -->
    <div class="px-4">
      <PaperPanel class="mx-auto mt-8 w-fit max-w-full p-2 pt-4 sm:p-4 md:p-12">
        <div class="flex flex-col items-center gap-4">
          <TypographyH1>{post.data.title}</TypographyH1>
          <div class="prose px-2">
            <Content />
          </div>
        </div>
      </PaperPanel>
    </div>
  </HeaderFooter>
</MetaLayout>
