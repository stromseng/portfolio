---
import HeaderFooter from "@/layouts/HeaderFooter.astro";
import MetaLayout from "@/layouts/MetaLayout.astro";
import { getCollection, render } from "astro:content";
import BackLink from "@/components/backlink.astro";
import { TypographyH1 } from "@/components/ui/typography";
import { Separator } from "@/components/ui/separator";
import PaperPanel from "@/components/PaperPanel.astro";
import PillBadge from "@/components/PillBadge";
export const prerender = true;

// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}
// 2. For your template, you can get the entry directly from the prop
const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
  }).format(date);
---

<MetaLayout title="Blog" bodyClass="bg-paper">
  <HeaderFooter headerClass="bg-paper">
    <BackLink href="/blog" />
    <div class="px-4">
      <PaperPanel class="mx-auto mt-8 w-full max-w-6xl p-4 pt-4 sm:p-4 md:p-12">
        <div class="flex flex-col items-center gap-4">
          <TypographyH1 className="text-center">{post.data.title}</TypographyH1>
             <p class="max-w-2xl text-center text-lg leading-relaxed text-black/80">
            {post.data.description}
          </p>
          <PillBadge
            as="time"
            dateTime={post.data.pubDate.toISOString()}
            background="bg-[#e6f0ff]"
          >
            {formatDate(post.data.pubDate)}
          </PillBadge>
          {post.data.tags?.length ? (
            <div class="flex flex-wrap justify-center gap-2">
              {post.data.tags.map((tag) => (
                <PillBadge
                  background="bg-[#fff0f0]"
                  className="px-3 py-1 text-[11px] tracking-[0.35em]"
                >
                  #{tag}
                </PillBadge>
              ))}
            </div>
          ) : null}
       
          <div class="prose px-2">
            <Content />
          </div>
        </div>
      </PaperPanel>
    </div>
  </HeaderFooter>
</MetaLayout>
