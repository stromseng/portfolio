---
// The blog's post list under the rooftop band (components/blog/). Taped,
// tilted paper panels by day; at night they're lamplit paper on the
// homepage's night sky.
import Construction from "@images/construction.svg";
import { getCollection } from "astro:content";
import PaperPanel from "@/components/PaperPanel.astro";
import PillBadge from "@/components/PillBadge";
import TapeStrip from "@/components/TapeStrip.astro";
import BlogLayout from "@/components/blog/BlogLayout.astro";
import { formatDate, pill } from "@/components/blog/post";
import { TypographyH1 } from "@/components/ui/typography";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const tilts = [
  { panel: "-rotate-1", tape: "rotate-4" },
  { panel: "rotate-1", tape: "-rotate-4" },
  { panel: "rotate-2", tape: "-rotate-6" },
  { panel: "-rotate-2", tape: "rotate-6" },
] as const;

const panel =
  "relative border-dashed border-black/70 bg-white dark:border-ink/50 dark:bg-paper-fill dark:shadow-[12px_12px_0_#070d1d]";
const tape = {
  colorClass: "bg-[#ffd84d] dark:bg-[#e0ad4c]",
  shadowClass:
    "shadow-[3px_3px_0_rgba(0,0,0,0.2)] dark:shadow-[3px_3px_0_rgba(0,0,0,0.45)]",
};
---

<BlogLayout title="Blog • Magnus A. Strømseng">
  {
    posts.length ? (
      <div class="mx-auto flex w-full max-w-6xl flex-col items-center px-4 pt-6 pb-24 md:px-8">
        <header class="flex w-full flex-col gap-4 text-center md:text-left">
          <TypographyH1 className="font-bold">Magnus' Blog</TypographyH1>
          <p class="max-w-prose text-lg leading-relaxed text-black/80 md:text-xl dark:text-ink-soft">
            My thoughts and experiences from the things I've done. It's kinda
            empty right now, but I'll add stuff here as I go. So enjoy the
            examples.
          </p>
        </header>
        <ul class="mt-12 grid w-full gap-12 sm:grid-cols-2">
          {posts.map((post, i) => {
            const tilt = tilts[i % tilts.length];
            return (
              <li>
                <a
                  href={`/blog/${post.id}`}
                  class="group relative block h-full text-black no-underline dark:text-ink"
                >
                  <PaperPanel
                    class:list={[
                      panel,
                      "flex h-full flex-col px-8 py-9 duration-200 group-hover:-translate-y-2 group-hover:rotate-0 group-hover:shadow-[18px_18px_0_rgba(0,0,0,0.35)] motion-safe:transition-all dark:group-hover:shadow-[18px_18px_0_#070d1d]",
                      tilt.panel,
                    ]}
                  >
                    <TapeStrip
                      class={`-top-6 left-1/2 h-8 w-28 -translate-x-1/2 ${tilt.tape}`}
                      {...tape}
                    />
                    <h2 class="text-2xl leading-snug font-semibold">
                      {post.data.title}
                    </h2>
                    <p class="mt-3 text-base leading-relaxed text-black/75 dark:text-ink-soft">
                      {post.data.description}
                    </p>
                    <PillBadge
                      as="time"
                      dateTime={post.data.pubDate.toISOString()}
                      background={pill.date}
                      className={`mt-3 ${pill.border}`}
                    >
                      {formatDate(post.data.pubDate)}
                    </PillBadge>
                    {post.data.tags?.length ? (
                      <div class="mt-3 flex flex-wrap gap-2">
                        {post.data.tags.map((tag) => (
                          <PillBadge
                            background={pill.tag}
                            className={`px-3 py-1 text-[11px] tracking-[0.35em] ${pill.border}`}
                          >
                            #{tag}
                          </PillBadge>
                        ))}
                      </div>
                    ) : null}
                    <span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold tracking-[0.3em] text-black/80 uppercase duration-200 group-hover:translate-x-1 motion-safe:transition-transform dark:text-lamp">
                      Read post
                      <span class="h-0.5 w-6 bg-current duration-200 group-hover:w-10 motion-safe:transition-all" />
                    </span>
                  </PaperPanel>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ) : (
      <div class="my-24 flex min-h-[60vh] flex-col items-center justify-center gap-6 px-4 text-center">
        <PaperPanel class:list={[panel, "max-w-xl px-10 py-12"]}>
          <TapeStrip class="-top-6 left-12 h-8 w-24 rotate-[-8deg]" {...tape} />
          <Construction class="mx-auto mb-6 h-auto w-60 dark:invert" />
          <h2 class="text-3xl font-semibold">Still sketching…</h2>
        </PaperPanel>
      </div>
    )
  }
</BlogLayout>
