---
export const prerender = true;
import MetaLayout from "@/layouts/MetaLayout.astro";
import PageContent from "@/layouts/Content.astro";
import Star from "@images/star.svg";
import HeaderFooter from "@/layouts/HeaderFooter.astro";
import PaperPanel from "@/components/PaperPanel.astro";
import BackLink from "@/components/backlink.astro";
import PillBadge from "@/components/PillBadge";
import TapeStrip from "@/components/TapeStrip.astro";
import ImagePanel from "@/components/ImagePanel.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

type ProjectEntry = CollectionEntry<"projects">;

export const getStaticPaths = async () => {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
};

const project = (Astro.props as { project: ProjectEntry }).project;
const { Content: ProjectBody } = await render(project);
const hasBodyContent = Boolean(project.body?.trim());

const projectData = project.data;

const projectTypeLabel = {
  personal: "Personal Project",
  client: "Client Project",
  school: "School Project",
};

const tags = projectData.tags?.filter((tag): tag is string =>
  Boolean(tag?.trim()),
);

const newBadgeText = projectData.newIndicator
  ? projectData.newIndicatorText?.trim() || "New"
  : null;

const mainImageUrl = projectData.mainImage;

const galleryImages = projectData.images;

const externalLinkClass =
  "inline-flex items-center gap-3 rounded-[9999px] border-[3px] border-black bg-white px-5 py-2 text-sm font-semibold text-black shadow-[6px_6px_0_rgba(0,0,0,0.4)] transition hover:-translate-y-0.5 hover:shadow-[10px_10px_0_rgba(0,0,0,0.4)]";
---

<MetaLayout
  title={`${projectData.title ?? "Project"} • Magnus A. Strømseng`}
  bodyClass="bg-paper"
>
  <HeaderFooter headerClass="bg-paper">
    <BackLink href="/#projects" />
    <PageContent class="mx-auto flex min-h-screen flex-col items-center">
      <div
        class="flex w-full flex-col items-center gap-12 md:flex-row md:items-stretch md:justify-center md:gap-14"
      >
        <PaperPanel class="relative w-full space-y-8 px-8 py-10 md:px-12">
          <TapeStrip class="-top-6 left-8 h-12 w-28 rotate-2" />
          {
            newBadgeText && (
              <img
                src={Star.src}
                alt={newBadgeText}
                class="absolute top-4 right-4 z-0 h-16 w-16"
              />
            )
          }
          <div class="relative z-10 space-y-4">
            <h1
              class="text-4xl leading-tight font-semibold text-black md:text-5xl"
            >
              {projectData.title}
            </h1>
            {
              projectData.shortDescription && (
                <p class="text-lg leading-relaxed text-black">
                  {projectData.shortDescription}
                </p>
              )
            }
          </div>
          <div class="relative z-10 flex flex-wrap items-center gap-3">
            {
              projectData.projectType && (
                <PillBadge
                  background="bg-white"
                  className="px-4 py-1.5 text-xs"
                >
                  {projectTypeLabel[projectData.projectType] ??
                    projectData.projectType}
                </PillBadge>
              )
            }
            {
              tags?.map((tag) => (
                <PillBadge
                  background="bg-[#e6f0ff]"
                  className="px-4 py-1.5 text-xs"
                >
                  {tag}
                </PillBadge>
              ))
            }
          </div>
          <div class="relative z-10 flex flex-wrap gap-4">
            {
              projectData.hostedLink && (
                <a
                  href={projectData.hostedLink}
                  class={externalLinkClass}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Visit Live Site
                </a>
              )
            }
            {
              projectData.githubLink && (
                <a
                  href={projectData.githubLink}
                  class={externalLinkClass}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  View Source
                </a>
              )
            }
          </div>
        </PaperPanel>
        {
          mainImageUrl ? (
            <ImagePanel
              src={mainImageUrl}
              alt={projectData.title ?? "Project image"}
              loading="eager"
              class="w-full md:w-auto md:max-w-xl"
            />
          ) : (
            <PaperPanel class="flex w-full items-center justify-center px-8 py-10 md:w-auto md:max-w-md">
              <span class="text-center text-base font-medium tracking-[0.2em] uppercase">
                Image coming soon
              </span>
            </PaperPanel>
          )
        }
      </div>
      <div class="my-16 flex w-full flex-col gap-16">
        {
          hasBodyContent ? (
            <PaperPanel class="prose prose-lg prose-headings:text-black prose-p:text-black prose-strong:text-black prose-li:text-black prose-a:text-black max-w-none px-10 py-12 text-black">
              <ProjectBody />
            </PaperPanel>
          ) : (
            <PaperPanel class="px-10 py-12 text-center">
              <h2 class="text-2xl font-semibold tracking-[0.2em] uppercase">
                Project write-up incoming
              </h2>
              <p class="mt-4 text-base">
                I'm still polishing the case study for this project—check back
                soon for more insights.
              </p>
            </PaperPanel>
          )
        }
        {
          galleryImages && galleryImages.length ? (
            <section class="flex flex-col gap-6">
              <h2 class="text-3xl font-semibold tracking-[0.3em] uppercase">
                Gallery
              </h2>
              <div class="grid gap-8 md:grid-cols-2">
                {galleryImages.map((imageUrl) => (
                  <ImagePanel src={imageUrl} />
                ))}
              </div>
            </section>
          ) : null
        }
      </div>
    </PageContent>
  </HeaderFooter>
</MetaLayout>
