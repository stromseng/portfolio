---
// One project's page. It has no scene, so night only swaps the colours: the
// homepage's night sky, cream ink and paper-fill pills and buttons.
export const prerender = true;
import MetaLayout from "@/layouts/MetaLayout.astro";
import PageContent from "@/layouts/Content.astro";
import Star from "@images/star.svg";
import Header from "@/components/Header.astro";
import BackLink from "@/components/backlink.astro";
import PillBadge from "@/components/PillBadge";
import { prose } from "@/components/prose";
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";

type ProjectEntry = CollectionEntry<"projects">;

export const getStaticPaths = async () => {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
};

const project = (Astro.props as { project: ProjectEntry }).project;
const { Content: ProjectBody } = await render(project);
const hasBodyContent = Boolean(project.body?.trim());

const projectData = project.data;

const projectTypeLabel = {
  personal: "Personal Project",
  client: "Client Project",
  school: "School Project",
};

const tags = projectData.tags?.filter((tag): tag is string =>
  Boolean(tag?.trim()),
);

const newBadgeText = projectData.newIndicator
  ? projectData.newIndicatorText?.trim() || "New"
  : null;

const mainImage = projectData.mainImage;
const galleryImages = projectData.images;

const externalLinkClass =
  "inline-flex items-center gap-3 rounded-[9999px] border-[3px] border-black bg-white px-5 py-2 text-sm font-semibold text-black shadow-[6px_6px_0_rgba(0,0,0,0.4)] transition hover:-translate-y-0.5 hover:shadow-[10px_10px_0_rgba(0,0,0,0.4)] dark:border-ink/70 dark:bg-paper-fill dark:text-ink dark:shadow-[6px_6px_0_#070d1d] dark:hover:shadow-[10px_10px_0_#070d1d]";

// Pill backgrounds: white and blue by day, paper fill and sea at night.
const pill = {
  type: "bg-white dark:bg-paper-fill",
  tag: "bg-[#e6f0ff] dark:bg-sea",
  border: "dark:border-ink/80",
} as const;
---

<MetaLayout
  title={`${projectData.title ?? "Project"} • Magnus A. Strømseng`}
  bodyClass="bg-paper text-black dark:bg-page dark:text-ink"
>
  <Header />
  <BackLink href="/#projects" />
  <PageContent class="mx-auto flex min-h-screen flex-col items-center">
    <div class="w-full space-y-6 text-center">
      <h1
        class="inline-flex items-center justify-center gap-3 text-4xl leading-tight font-semibold md:text-5xl"
      >
        {projectData.title}
        {
          newBadgeText && (
            <img
              src={Star.src}
              alt={newBadgeText}
              class="h-14 w-14 md:h-20 md:w-20"
            />
          )
        }
      </h1>
      {
        projectData.shortDescription && (
          <p class="mx-auto max-w-prose text-lg leading-relaxed">
            {projectData.shortDescription}
          </p>
        )
      }
      <div class="flex flex-wrap items-center justify-center gap-3">
        {
          projectData.projectType && (
            <PillBadge
              background={pill.type}
              className={`px-4 py-1.5 text-xs ${pill.border}`}
            >
              {projectTypeLabel[projectData.projectType] ??
                projectData.projectType}
            </PillBadge>
          )
        }
        {
          tags?.map((tag) => (
            <PillBadge
              background={pill.tag}
              className={`px-4 py-1.5 text-xs ${pill.border}`}
            >
              {tag}
            </PillBadge>
          ))
        }
      </div>
      <div class="flex flex-wrap justify-center gap-4">
        {
          projectData.hostedLink && (
            <a
              href={projectData.hostedLink}
              class={externalLinkClass}
              target="_blank"
              rel="noopener noreferrer"
            >
              Visit Live Site
            </a>
          )
        }
        {
          projectData.githubLink && (
            <a
              href={projectData.githubLink}
              class={externalLinkClass}
              target="_blank"
              rel="noopener noreferrer"
            >
              View Source
            </a>
          )
        }
      </div>
    </div>
    {
      mainImage && (
        <div class="mt-12 w-full">
          <Image
            src={mainImage}
            alt={projectData.title ?? "Project image"}
            loading="eager"
            class="mx-auto h-auto w-full max-w-4xl rounded-lg object-contain"
          />
        </div>
      )
    }
    <div class="my-8 flex w-full flex-col gap-16">
      {
        hasBodyContent ? (
          <div class:list={["mx-auto prose-lg max-w-prose", prose]}>
            <ProjectBody />
          </div>
        ) : (
          <div class="text-center">
            <h2 class="text-2xl font-semibold tracking-[0.2em] uppercase">
              Project write-up incoming
            </h2>
            <p class="mt-4 text-base">
              I'm still polishing the case study for this project—check back
              soon for more insights.
            </p>
          </div>
        )
      }
      {
        galleryImages && galleryImages.length ? (
          <section class="flex flex-col gap-6">
            <h2 class="text-3xl font-semibold tracking-[0.3em] uppercase">
              Gallery
            </h2>
            <div class="grid gap-8 md:grid-cols-2">
              {galleryImages.map((image) => (
                <Image
                  src={image}
                  alt=""
                  class="h-auto w-full rounded-lg object-contain"
                />
              ))}
            </div>
          </section>
        ) : null
      }
    </div>
  </PageContent>
</MetaLayout>
