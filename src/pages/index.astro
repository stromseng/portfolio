---
// The homepage: a hand-drawn landscape that works by day and after dark.
// Scenes live in src/components/home/scenes/, the palette in
// src/styles/globals.css and the CSS for scene internals in src/styles/scenes.css.
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import "@fontsource-variable/shantell-sans/full.css";
import "@/styles/globals.css";
import "@/styles/scenes.css";
import { getCollection } from "astro:content";
import shootingStar from "@images/doodles/shootingstar.svg?raw";
import whale from "@images/doodles/whale.svg?raw";
import doodleBackground from "@images/DoodleBackground.svg?raw";
import grassBot from "@images/grass-bot.svg?raw";
import hireButton from "@images/hire-button.svg?raw";
import logoClimber from "@images/logo-climber.svg?raw";
import projectBot from "@images/project-bot.svg?raw";
import smiley from "@images/smiley.svg?raw";
import Star from "@images/star.svg";
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import { fireflies, skyMarks } from "@/components/home/sky";
import ThemeToggle from "@/components/home/ThemeToggle.astro";
import TypingTagline from "@/components/home/TypingTagline.svelte";
import { ageOn, education, taglines, work } from "@/components/home/content";
import { sceneSvg } from "@/lib/scene/scene";
import { city } from "@/components/home/scenes/city";
import { footer } from "@/components/home/scenes/footer";
import { meadow } from "@/components/home/scenes/meadow";
import { seaBottom, seaTop } from "@/components/home/scenes/sea";
import { themeSvg } from "@/lib/scene/themeSvg";

const projects = (await getCollection("projects")).sort(
  (a, b) =>
    (a.data.sortOrder ?? Number.MAX_SAFE_INTEGER) -
    (b.data.sortOrder ?? Number.MAX_SAFE_INTEGER),
);

const timelines = [
  { title: "Education", items: education },
  { title: "Work", items: work },
];

const age = ageOn(new Date());

// Each band is a wave scene, a coloured body and a wave scene. The body
// overlaps the waves by a pixel, so no hairline shows at the seams.
const bandBody = "relative -my-px flex justify-center px-5 sm:px-8 lg:px-12";
const heading = "text-3xl font-bold lg:text-4xl";
---

<!doctype html>
<html
  lang="en"
  data-themed
  class="scheme-light-dark data-[theme=day]:scheme-light data-[theme=night]:scheme-dark"
>
  <head>
    <BaseHead title="Magnus A. Strømseng">
      <meta name="color-scheme" content="light dark" />
      <script is:inline>
        // Runs before paint so a returning night visitor never sees a day flash.
        // "theme" is the key ThemeToggle.astro stores the visitor's choice under.
        (() => {
          let stored = null;
          try {
            stored = localStorage.getItem("theme");
          } catch {}
          const night =
            stored === "night" ||
            (stored !== "day" &&
              window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.dataset.theme = night ? "night" : "day";
        })();
      </script>
    </BaseHead>
  </head>
  <body class="overflow-x-hidden bg-page text-lg text-ink">
    <a
      class="absolute -top-16 left-4 z-30 border-2 border-line bg-paper-fill px-4 py-2 underline decoration-2 underline-offset-4 focus:top-4"
      href="#main">Skip to content</a
    >

    <Header>
      <span class="size-12"><ThemeToggle /></span>
    </Header>

    <main id="main">
      <section
        class="relative mx-auto grid max-w-7xl grid-cols-1 items-center justify-items-center gap-12 px-4 pt-16 pb-8 sm:px-6 lg:grid-cols-[1.2fr_1fr] lg:px-10 lg:pt-20 lg:pb-12"
        aria-labelledby="hero-name"
      >
        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
          {
            /* The icon heads up-right; the rotation turns it into a star
              falling down-right, its tails trailing up-left. */
          }
          <Fragment
            set:html={themeSvg(shootingStar, {
              id: "shooting-star",
              className:
                "shooting-star night-only absolute top-[5%] left-[55%] w-16 rotate-80 lg:w-28",
            })}
          />
          {/* Gulls by day; every mark is a star at night. */}
          {
            skyMarks.map((mark, i) => (
              <svg
                class="absolute h-auto overflow-visible"
                viewBox="0 0 24 24"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
                style={`left:${mark.x}%;top:${mark.y}%;width:${mark.size}px;--i:${i}`}
              >
                <path
                  class="mark-star fill-star/35 stroke-star stroke-2 opacity-0 dark:opacity-100"
                  d="M12 3c.5 5 1 7.5 8 9-6.5 1-7.4 3-8 9-.6-6-1.5-8-8-9 6.5-1 7.5-3.5 8-9"
                />
                {mark.bird && (
                  <path
                    class="stroke-line stroke-[1.8] opacity-70 dark:opacity-0"
                    d="M2 13c3-4 7-4 10 0 3-4 7-4 10 0"
                  />
                )}
              </svg>
            ))
          }
        </div>

        <div class="relative isolate w-full max-w-xl p-10 sm:p-14 lg:p-22">
          <Fragment
            set:html={themeSvg(doodleBackground, {
              id: "hero-doodle",
              className: "absolute inset-0 -z-10 size-full",
            })}
          />
          <p class="mb-3 text-xl">Hi there, I'm</p>
          <h1
            id="hero-name"
            class="mb-4 text-5xl leading-[1.1] font-extrabold tracking-tight sm:text-6xl md:text-7xl"
          >
            Magnus<br />Alexander<br />Strømseng
          </h1>
          <TypingTagline client:load phrases={taglines} />
          <p class="mt-2 mb-6 max-w-88 text-xl leading-snug text-ink-soft">
            A full-time developer at Bekk, based in Oslo.
          </p>
          {
            /* By night the button is the warmest thing on the page: a lit lantern. */
          }
          <a
            class="relative inline-grid h-14 w-32 place-items-center font-bold text-ink duration-200 hover:-rotate-2 motion-safe:transition-transform dark:text-[#2a1c05] dark:[--color-line:#fff1cf] dark:[--color-sea:var(--color-lamp)]"
            href="mailto:hireme@stromseng.dev"
          >
            <Fragment
              set:html={themeSvg(hireButton, {
                id: "hire",
                className:
                  "absolute inset-0 size-full dark:drop-shadow-[0_0_14px_rgb(255_197_110/0.6)]",
              })}
            />
            <span class="relative">Hire me</span>
          </a>
        </div>

        {
          /* At night the logo's pink and green get brighter shades, matching the
            blue's contrast against the sky (about 4.5:1). */
        }
        <div
          class="relative w-full max-w-104 *:w-full dark:[--color-bramble:#b46f83] dark:[--color-grass:#4a9464]"
        >
          <Fragment set:html={themeSvg(logoClimber, { id: "climber" })} />
        </div>
      </section>

      {/* Lines in each band take on that band's night light. */}
      <section
        class="dark:[--color-line:#cfe0f2]"
        aria-labelledby="about-title"
      >
        <Fragment set:html={sceneSvg(seaTop, "w-full")} />
        <div class:list={[bandBody, "bg-sea py-12"]}>
          <Fragment
            set:html={themeSvg(whale, {
              id: "whale",
              className: "absolute top-[14%] left-14 hidden w-32 xl:block",
            })}
          />
          <div
            class="flex max-w-5xl flex-col items-center gap-12 text-center md:min-h-104 md:flex-row md:justify-between md:gap-24 md:text-left"
          >
            <div class="max-w-136">
              <h2 id="about-title" class={heading}>About me</h2>
              <p class="mt-4 text-xl leading-normal">
                I'm a {age} year old developer from Oslo, Norway. I work full-time
                at Bekk and hold a master's degree in Informatics and Artificial
                Intelligence from NTNU, with an exchange semester at Seoul National
                University along the way. I'm passionate about technology, love learning
                new things, and am a big fan of open source software.
              </p>
            </div>
            <div class="w-28 shrink-0 *:w-full lg:w-44">
              <Fragment set:html={themeSvg(smiley, { id: "smiley" })} />
            </div>
          </div>
        </div>
        <Fragment
          set:html={sceneSvg(seaBottom, "w-full dark:[--color-line:#7f95ba]")}
        />
      </section>

      <section
        class="dark:[--color-line:#d8e4c0]"
        aria-label="Education and work"
      >
        <Fragment set:html={sceneSvg(meadow, "w-full")} />
        <div class:list={[bandBody, "bg-grass py-16"]}>
          <div
            class="pointer-events-none absolute inset-0 opacity-0 dark:opacity-100"
            aria-hidden="true"
          >
            {
              fireflies.map((fly, i) => (
                <span
                  class="firefly absolute size-2 rounded-full bg-[#fff0b8] shadow-[0_0_6px_2px_var(--color-lamp),0_0_18px_6px_rgb(255_197_110/0.35)]"
                  style={`left:${fly.x}%;top:${fly.y}%;--i:${i}`}
                />
              ))
            }
          </div>
          <div
            class="relative grid w-full max-w-6xl gap-14 lg:grid-cols-2 lg:gap-16"
          >
            {
              timelines.map((timeline) => (
                <div>
                  <h2 class={heading}>{timeline.title}</h2>
                  <ol class="mt-7 grid gap-7">
                    {timeline.items.map((item) => (
                      <li class="flex items-start gap-4">
                        <span class="w-16 shrink-0 *:w-full">
                          <Fragment set:html={item.icon} />
                        </span>
                        <span class="flex flex-col">
                          <span class="font-semibold text-grass-ink">
                            {item.period}
                          </span>
                          <span class="text-xl leading-tight font-bold">
                            {item.title}
                          </span>
                          <span>{item.text}</span>
                        </span>
                      </li>
                    ))}
                  </ol>
                </div>
              ))
            }
          </div>
        </div>
        <Fragment
          set:html={themeSvg(grassBot, {
            id: "grass-bot",
            className: "w-full",
          })}
        />
      </section>

      <section class="dark:[--color-line:#efd2d9]" aria-labelledby="projects">
        <Fragment set:html={sceneSvg(city, "w-full")} />
        <div
          class:list={[
            bandBody,
            "flex-col items-center gap-12 bg-bramble pt-16 pb-20",
          ]}
        >
          <div class="max-w-2xl text-center">
            <h2 id="projects" class={heading}>Projects</h2>
            <p class="mt-3 text-xl text-bramble-ink">
              A snapshot of the products and experiments I have built along the
              way.
            </p>
          </div>
          {
            /* Frosted white cards by day. At night they turn to dusk paper, a plum
              a shade lighter than the band, with cream text. */
          }
          <ul class="grid w-full max-w-6xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {
              projects.map(({ data }) => {
                const tags = data.tags?.filter((tag) => tag.trim());
                return (
                  <li>
                    <a
                      class="relative flex h-full flex-col rounded-3xl bg-white/80 p-6 shadow-lg duration-300 hover:-translate-y-1 hover:shadow-xl motion-safe:transition-[translate,box-shadow] dark:bg-[#4b2d45] dark:shadow-black/35"
                      href={`/project/${data.slug}`}
                    >
                      {data.newIndicator && (
                        <img
                          class="absolute top-4 right-4 size-16"
                          src={Star.src}
                          alt="New project"
                        />
                      )}
                      <h3 class="text-2xl font-semibold text-gray-900 dark:text-[#f6ecd9]">
                        {data.title}
                      </h3>
                      <p class="mt-3 text-base text-gray-700 dark:text-[#e3cfd8]">
                        {data.shortDescription ??
                          "Dive in to explore what went into this project."}
                      </p>
                      {tags?.length ? (
                        <ul class="mt-6 flex flex-wrap gap-2">
                          {tags.map((tag) => (
                            <li class="rounded-full bg-sea px-3 py-1 text-xs font-medium tracking-wide text-gray-900 uppercase dark:bg-[#2c1a2a] dark:text-[#f6ecd9]">
                              {tag}
                            </li>
                          ))}
                        </ul>
                      ) : null}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </div>
        <Fragment
          set:html={themeSvg(projectBot, {
            id: "project-bot",
            className: "w-full",
          })}
        />
      </section>
    </main>

    {/* The cleaning man (by day) or the sleeper (at night) above a note. */}
    <footer class="my-24 flex min-h-96 flex-col items-center justify-center">
      <Fragment set:html={sceneSvg(footer, "w-[90vw] max-w-md")} />
      <span>
        Nothing more to see here...<br />
        Check out my <a
          class="font-bold underline decoration-2 underline-offset-4"
          href="/blog">blog</a
        > instead
      </span>
    </footer>
    <Analytics />
    <SpeedInsights />
  </body>
</html>
