---
import Layout from "../layouts/Layout.astro";
import "@/styles/globals.css";
import { Content as Readme } from "@/../README.md";
import Content from "@/layouts/Content.astro";
import SelfTypingCode from "@/components/SelfTypingCode.svelte";
import SelfDrawingLogoSVG from "@/components/SelfDrawingLogoSVG.svelte";
import SelfTypingText from "@/components/SelfTypingText.svelte";
import DoodleBackground from "@images/DoodleBackground.svg";
---

<Layout title="Magnus A. Strømseng">
  <div class="flex w-full flex-col items-center">
    <div
      class="mt-24 mb-24 flex flex-col items-center justify-between gap-12 px-5 md:mb-24 lg:w-full lg:max-w-7xl lg:grow lg:flex-row"
    >
      <div
        class="inline-block bg-[url('/DoodleBackground.svg')] bg-contain bg-no-repeat p-24"
      >
        <div class="">
          <div class="prose mb-4"><p class="">Hi there 👋 I'm</p></div>
          <h1 class="h1 text-6xl sm:text-7xl">
            <span class="bg-p-blue rounded-lg">Magnus</span>
            <br />
            <span class="|">Alexander</span>
            <br /> Strømseng
          </h1>
        </div>
        <SelfTypingText
          client:load
          text={[
            "Full Stack Developer",
            "Informatics Student",
            "Tech Enthusiast",
            "E-Sports Player",
            "I use Nix btw",
          ]}
        />
        <div class="">
          <p class="my-2 max-w-xs text-xl">
            A Fullstack Developer and Informatics Student from Norway.
          </p>
        </div>
        <a
          href="mailto: magnus.stromseng+work@gmail.com"
          class="relative inline-flex h-[54px] w-[127px] shrink items-center justify-center"
        >
          <img src="/hire-button.svg" class="absolute inset-0 h-full w-full" />
          <span class="relative z-10">Hire me</span>
        </a>
      </div>
      <div class="w-[440px] content-normal justify-normal">
        <img src="/logo-climber.svg" />
      </div>
    </div>
  </div>

  <!-- About me section -->
  <div>
    <img src="/sea-top-boat.svg" class="w-full object-cover" />
    <div
      class="bg-p-blue flex h-[500px] flex-row flex-nowrap items-center justify-evenly"
    >
      <div class="prose gap-2">
        <h2 class="">About Me</h2>
        <p class="text-l">
          I'm a 23 year old Informatics student from Oslo, Norway. I'm currently
          in the first year of my master's degree at the Norwegian University of
          Technology and Science. I'm passionate about technology and I love to
          learn new things. I'm also a big fan of open source software and I try
          to contribute to open source projects whenever I can. You can read
          more about me <a href="/about">here</a>
        </p>
      </div>
      <div><img src="/smiley.svg" /></div>
    </div>
    <img src="/sea-bot.svg" class="w-full object-cover" />
  </div>
  <!-- Work and Education -->
  <div>
    <img src="/grass-top.svg" class="w-full object-cover" />
    <div class="bg-p-green flex w-full justify-center">
      <div
        class="flex w-full max-w-6xl flex-row flex-wrap items-start justify-between gap-12 px-6 py-16"
      >
        <div class="flex min-w-[260px] grow flex-col gap-6">
          <h2 class="text-4xl font-bold">Education</h2>
          <div class="flex flex-col gap-6">
            <div class="flex items-start gap-4">
              <img src="/uni-dot.svg" alt="" class="mt-1 h-12 w-12 shrink-0" />
              <div class="flex flex-col">
                <span class="text-lg font-semibold">2024-2026</span>
                <span class="text-xl font-bold">
                  Norwegian Institute of Technology and Science
                </span>
                <span class="text-base">Master in Informatics</span>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <img src="/uni-dot.svg" alt="" class="mt-1 h-12 w-12 shrink-0" />
              <div class="flex flex-col">
                <span class="text-lg font-semibold">2021-2024</span>
                <span class="text-xl font-bold">
                  Norwegian Institute of Technology and Science
                </span>
                <span class="text-base">Bachelor in Informatics</span>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <img src="/uni-dot.svg" alt="" class="mt-1 h-12 w-12 shrink-0" />
              <div class="flex flex-col">
                <span class="text-lg font-semibold">2017-2020</span>
                <span class="text-xl font-bold">Nydalen VGS</span>
                <span class="text-base">Studiespesialiserende</span>
              </div>
            </div>
          </div>
        </div>
        <div class="flex min-w-[260px] grow flex-col gap-6">
          <h2 class="text-4xl font-bold">Work</h2>
          <div class="flex flex-col gap-6">
            <div class="flex items-start gap-4">
              <img
                src="/work-dot.svg"
                alt=""
                class="mt-1 h-12 w-12 flex-shrink-0"
              />
              <div class="flex flex-col">
                <span class="text-lg font-semibold">2024</span>
                <span class="text-xl font-bold">Thales Norway</span>
                <span class="text-base">Summer Intern</span>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <img
                src="/work-dot.svg"
                alt=""
                class="mt-1 h-12 w-12 flex-shrink-0"
              />
              <div class="flex flex-col">
                <span class="text-lg font-semibold">2021-2023</span>
                <span class="text-xl font-bold">Linderud IL, Camp Linderud</span
                >
                <span class="text-base">Team Leader</span>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <img
                src="/work-dot.svg"
                alt=""
                class="mt-1 h-12 w-12 flex-shrink-0"
              />
              <div class="flex flex-col">
                <span class="text-lg font-semibold">2017-2020</span>
                <span class="text-xl font-bold">Linderud IL, Camp Linderud</span
                >
                <span class="text-base">Camp Staff</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <img src="/grass-bot.svg" class="w-full object-cover" />
  </div>
</Layout>
