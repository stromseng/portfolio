---
// The homepage: a hand-drawn landscape that works by day and after dark.
// Scenes live in src/components/home/scenes/, colours in src/styles/home.css.
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import "@fontsource-variable/shantell-sans/full.css";
import "@/styles/home.css";
import { getCollection } from "astro:content";
import shootingStar from "@images/doodles/shootingstar.svg?raw";
import whale from "@images/doodles/whale.svg?raw";
import doodleBackground from "@images/DoodleBackground.svg?raw";
import grassBot from "@images/grass-bot.svg?raw";
import hireButton from "@images/hire-button.svg?raw";
import logoClimber from "@images/logo-climber.svg?raw";
import projectBot from "@images/project-bot.svg?raw";
import smiley from "@images/smiley.svg?raw";
import Star from "@images/star.svg";
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import { fireflies, skyMarks } from "@/components/home/sky";
import ThemeToggle from "@/components/home/ThemeToggle.astro";
import TypingTagline from "@/components/home/TypingTagline.svelte";
import { ageOn, education, taglines, work } from "@/components/home/content";
import { sceneSvg } from "@/lib/scene/scene";
import { city } from "@/components/home/scenes/city";
import { footer } from "@/components/home/scenes/footer";
import { meadow } from "@/components/home/scenes/meadow";
import { seaBottom, seaTop } from "@/components/home/scenes/sea";
import { themeSvg } from "@/lib/scene/themeSvg";

const projects = (await getCollection("projects")).sort(
  (a, b) =>
    (a.data.sortOrder ?? Number.MAX_SAFE_INTEGER) -
    (b.data.sortOrder ?? Number.MAX_SAFE_INTEGER),
);

const timelines = [
  { title: "Education", items: education },
  { title: "Work", items: work },
];

const age = ageOn(new Date());
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Magnus A. Strømseng">
      <meta name="color-scheme" content="light dark" />
      <script is:inline>
        // Runs before paint so a returning night visitor never sees a day flash.
        // "theme" is the key ThemeToggle.astro stores the visitor's choice under.
        (() => {
          let stored = null;
          try {
            stored = localStorage.getItem("theme");
          } catch {}
          const night =
            stored === "night" ||
            (stored !== "day" &&
              window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.dataset.theme = night ? "night" : "day";
        })();
      </script>
    </BaseHead>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <Header>
      <span class="toggle-slot"><ThemeToggle /></span>
    </Header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-name">
        <div class="sky" aria-hidden="true">
          <Fragment
            set:html={themeSvg(shootingStar, {
              id: "shooting-star",
              className: "shooting-star night-only",
            })}
          />
          {
            skyMarks.map((mark, i) => (
              <svg
                class="mark"
                viewBox="0 0 24 24"
                style={`left:${mark.x}%;top:${mark.y}%;width:${mark.size}px;--i:${i}`}
              >
                <path
                  class="mark-star"
                  d="M12 3c.5 5 1 7.5 8 9-6.5 1-7.4 3-8 9-.6-6-1.5-8-8-9 6.5-1 7.5-3.5 8-9"
                />
                {mark.bird && (
                  <path class="mark-bird" d="M2 13c3-4 7-4 10 0 3-4 7-4 10 0" />
                )}
              </svg>
            ))
          }
        </div>

        <div class="hero-card">
          <Fragment
            set:html={themeSvg(doodleBackground, {
              id: "hero-doodle",
              className: "hero-doodle",
            })}
          />
          <p class="hello">Hi there, I'm</p>
          <h1 id="hero-name">Magnus<br />Alexander<br />Strømseng</h1>
          <TypingTagline client:load phrases={taglines} />
          <p class="intro">A full-time developer at Bekk, based in Oslo.</p>
          <a class="hire" href="mailto:hireme@stromseng.dev">
            <Fragment set:html={themeSvg(hireButton, { id: "hire" })} />
            <span>Hire me</span>
          </a>
        </div>

        <div class="climber">
          <Fragment set:html={themeSvg(logoClimber, { id: "climber" })} />
        </div>
      </section>

      <section class="sea" aria-labelledby="about-title">
        <Fragment set:html={sceneSvg(seaTop)} />
        <div class="band-body">
          <Fragment
            set:html={themeSvg(whale, { id: "whale", className: "whale" })}
          />
          <div class="about">
            <div class="prose">
              <h2 id="about-title">About me</h2>
              <p>
                I'm a {age} year old developer from Oslo, Norway. I work full-time
                at Bekk and hold a master's degree in Informatics and Artificial
                Intelligence from NTNU, with an exchange semester at Seoul National
                University along the way. I'm passionate about technology, love learning
                new things, and am a big fan of open source software.
              </p>
            </div>
            <div class="smiley">
              <Fragment set:html={themeSvg(smiley, { id: "smiley" })} />
            </div>
          </div>
        </div>
        <Fragment set:html={sceneSvg(seaBottom)} />
      </section>

      <section class="meadow" aria-label="Education and work">
        <Fragment set:html={sceneSvg(meadow)} />
        <div class="band-body">
          <div class="fireflies" aria-hidden="true">
            {
              fireflies.map((fly, i) => (
                <span style={`left:${fly.x}%;top:${fly.y}%;--i:${i}`} />
              ))
            }
          </div>
          <div class="timelines">
            {
              timelines.map((timeline) => (
                <div class="timeline">
                  <h2>{timeline.title}</h2>
                  <ol>
                    {timeline.items.map((item) => (
                      <li>
                        <span class="timeline-icon">
                          <Fragment set:html={item.icon} />
                        </span>
                        <span class="timeline-text">
                          <span class="period">{item.period}</span>
                          <span class="place">{item.title}</span>
                          <span>{item.text}</span>
                        </span>
                      </li>
                    ))}
                  </ol>
                </div>
              ))
            }
          </div>
        </div>
        <Fragment
          set:html={themeSvg(grassBot, { id: "grass-bot", className: "band" })}
        />
      </section>

      <section class="bramble" aria-labelledby="projects">
        <Fragment set:html={sceneSvg(city)} />
        <div class="band-body">
          <div class="projects-head">
            <h2 id="projects">Projects</h2>
            <p>
              A snapshot of the products and experiments I have built along the
              way.
            </p>
          </div>
          <ul class="cards">
            {
              projects.map(({ data }) => {
                const tags = data.tags?.filter((tag) => tag.trim());
                return (
                  <li>
                    <a class="card" href={`/project/${data.slug}`}>
                      {data.newIndicator && (
                        <img
                          class="card-star"
                          src={Star.src}
                          alt="New project"
                        />
                      )}
                      <h3>{data.title}</h3>
                      <p class="card-text">
                        {data.shortDescription ??
                          "Dive in to explore what went into this project."}
                      </p>
                      {tags?.length ? (
                        <ul class="tags">
                          {tags.map((tag) => (
                            <li>{tag}</li>
                          ))}
                        </ul>
                      ) : null}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </div>
        <Fragment
          set:html={themeSvg(projectBot, {
            id: "project-bot",
            className: "band",
          })}
        />
      </section>
    </main>

    <footer class="site-footer">
      <div class="cleaner">
        <Fragment set:html={sceneSvg(footer, "")} />
      </div>
      <span>
        Nothing more to see here...<br />
        Check out my <a href="/blog">blog</a> instead
      </span>
    </footer>
    <Analytics />
    <SpeedInsights />
  </body>
</html>
