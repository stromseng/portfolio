{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strictNullChecks": true, // astro: add if using `base` template
    "allowJs": true, // astro: required, and included with all Astro templates
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@images/*": ["src/data/images/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
